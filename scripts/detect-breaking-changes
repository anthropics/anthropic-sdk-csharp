#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Detecting breaking changes"

TEST_PATHS=( src/Anthropic.Tests/Services src/Anthropic.Tests/Models )

# Refuse to wipe untracked (non-ignored) files, so a local run can't silently
# delete work in progress.
UNTRACKED=$(git ls-files --others --exclude-standard -- "${TEST_PATHS[@]}")
if [ -n "$UNTRACKED" ]; then
    echo "error: refusing to wipe test directories, untracked files present:" >&2
    printf '  %s\n' $UNTRACKED >&2
    echo "Commit, stash, or remove them and re-run." >&2
    exit 1
fi

for PATHSPEC in "${TEST_PATHS[@]}"; do
    # Wipe first: `git checkout <ref> -- <path>` keeps files absent at <ref>,
    # and tests that are new on this branch can collide with the old ones.
    rm -rf "${PATHSPEC}"
    # Try to check out previous versions of the test files
    # with the current SDK.
    git checkout "$1" -- "${PATHSPEC}" 2>/dev/null || true
done

# Instead of running the tests, compile them: an older test that no longer
# builds is no longer compatible with the latest SDK.
ERRORS=$(mktemp)
if dotnet build src/Anthropic.Tests/Anthropic.Tests.csproj "-flp:errorsonly;logfile=$ERRORS"; then
    exit 0
fi

# ResponseOnlyTests.txt lists the tests of models that appear only in API responses, which only code
# that fakes a response creates. Fail if no error was logged, or on any error but the two kinds ignored there.
awk -v tests=src/Anthropic.Tests/Models/ResponseOnlyTests.txt -v root="$PWD/" '
    BEGIN { while ((getline test < tests) > 0) response_only[test] }
    { file = substr($0, index($0, root) + length(root)); sub(/\(.*/, "", file) }
    / error CS(9035|8625): / && file in response_only { ignored++; next }
    { failing = failing $0 "\n" }
    END {
        ignorable = "required members left unset (CS9035) and nulls no longer allowed (CS8625), in tests of models that appear only in API responses"
        if (failing && ignored) printf "==> Breaking changes found. Ignored %d error(s) above: %s. These errors fail the check:\n%s", ignored, ignorable, failing
        if (failing || !ignored) exit 1
        print "==> No breaking changes. Ignored all " ignored " error(s) above: " ignorable
    }
' "$ERRORS"
