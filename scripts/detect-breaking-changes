#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Detecting breaking changes"

TEST_PATHS=( src/Anthropic.Tests/Services src/Anthropic.Tests/Models )

# Refuse to wipe untracked (non-ignored) files, so a local run can't silently
# delete work in progress.
UNTRACKED=$(git ls-files --others --exclude-standard -- "${TEST_PATHS[@]}")
if [ -n "$UNTRACKED" ]; then
    echo "error: refusing to wipe test directories, untracked files present:" >&2
    printf '  %s\n' $UNTRACKED >&2
    echo "Commit, stash, or remove them and re-run." >&2
    exit 1
fi

for PATHSPEC in "${TEST_PATHS[@]}"; do
    # Wipe first: `git checkout <ref> -- <path>` keeps files absent at <ref>,
    # and tests that are new on this branch can collide with the old ones.
    rm -rf "${PATHSPEC}"
    # Try to check out previous versions of the test files
    # with the current SDK.
    git checkout "$1" -- "${PATHSPEC}" 2>/dev/null || true
done

# Instead of running the tests, compile them: an older test that no longer
# builds is no longer compatible with the latest SDK.
dotnet build src/Anthropic.Tests/Anthropic.Tests.csproj
