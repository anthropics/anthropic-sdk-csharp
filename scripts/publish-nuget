#!/usr/bin/env bash

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

# The version manifest gives each package's version, and the project file in its folder gives its name
manifest="$(jq -r 'to_entries[] | [.key, .value] | @tsv' .version-manifest.json)"
packages=()
identities=()
while read -r folder version; do
  project="$(basename "$folder"/*.csproj .csproj)"
  packages+=("artifacts/packages/$project.$version.nupkg")
  identities+=("$project $version")
done <<<"$manifest"

# fails for a missing file, so that nothing is published
wc -c "${packages[@]}"

# NuGet goes by the id and the version inside a package, so it has to find each of them. It looks in a folder of
# just these packages, so that none can stand in for two.
copies="$(mktemp -d)"
cp "${packages[@]}" "$copies"
for identity in "${identities[@]}"; do
  if ! dotnet package search "${identity% *}" --exact-match --prerelease --source "$copies" --format json |
    jq -e --arg identity "$identity" '.searchResult[].packages[] | select("\(.id) \(.version)" == $identity)'; then
    echo "Not publishing: NuGet doesn't find $identity among the packages."
    exit 1
  fi
done

dotnet nuget push "${packages[@]}" \
  --source https://api.nuget.org/v3/index.json \
  --api-key "$NUGET_API_KEY" \
  --no-symbols \
  --skip-duplicate
